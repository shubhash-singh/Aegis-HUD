<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Aegis" parent="@android:style/Theme.Material.NoActionBar">
        <!-- Transparent system bars so content draws fully edge-to-edge -->
        <item name="android:windowBackground">@drawable/home_bg</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Allow content to flow into notch / camera cutout area (API 28+) -->
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
        <!-- Disable automatic scrim enforcement (API 29+) -->
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
    </style>

</resources>
